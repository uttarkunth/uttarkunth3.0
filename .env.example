# ==============================================================================
# UTTARKUNTH STAYS 3.0 — RUNTIME CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit your real `.env.local` or any secrets to GitHub.
# For Cloudflare deployment, configure these under Cloudflare Dashboard:
# Workers & Pages -> your-worker -> Settings -> Variables and Secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE PUBLIC CLIENT CONFIGURATION (Safe for browser / Client Components)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://xyplgugxpmlnjsvlosdg.supabase.co

# Your Supabase Anonymous / Publishable Key (JWT anon key or modern sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here

# ------------------------------------------------------------------------------
# SUPABASE SERVER-SIDE PRIVILEGED ACCESS (STRICTLY SERVER-ONLY)
# ------------------------------------------------------------------------------
# Keep this secret! Only used by Server Actions / Route Handlers for privileged
# operations (e.g. host approval reconciliation, rate limiting, admin oversight).
# NEVER prefix with NEXT_PUBLIC_ and NEVER expose to browser JavaScript.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://uttarkunth3.pages.dev
NODE_ENV=production
